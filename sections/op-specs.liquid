{% comment %}
  Specs & size: an honest table + "Good to know" (what the product is NOT). Rows with an empty value are hidden.
{% endcomment %}
{{ 'op.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_rows = false
  for block in section.blocks
    if block.settings.value != blank
      assign has_rows = true
    endif
  endfor
-%}
{%- if has_rows or section.settings.good_to_know != blank or request.design_mode -%}
  <section class="op-section op-specs color-{{ section.settings.color_scheme }} gradient" id="op-specs">
    <div class="page-width op-specs__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="op-section__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if has_rows -%}
        <table class="op-specs__table">
          <caption class="visually-hidden">{{ section.settings.heading | escape }}</caption>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.settings.value != blank -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.label | escape }}</th>
                  <td>{{ block.settings.value | escape }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      {%- elsif request.design_mode -%}
        <p class="op-editor-note">Fill in the row values (from your product facts). Empty rows stay hidden.</p>
      {%- endif -%}
      {%- if section.settings.size_image != blank -%}
        <div class="op-specs__image">
          {{
            section.settings.size_image
            | image_url: width: 1200
            | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 600px, 100vw', loading: 'lazy'
          }}
        </div>
      {%- endif -%}
      {%- if section.settings.good_to_know != blank -%}
        <div class="op-specs__note">
          <p class="op-specs__note-title">
            {% render 'op-icon', icon: 'check', size: 20 %}
            {{ section.settings.good_to_know_title | escape }}
          </p>
          <div class="rte">{{ section.settings.good_to_know }}</div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "OP · Specs & size",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specs & size" },
    { "type": "image_picker", "id": "size_image", "label": "Size chart image (optional)" },
    { "type": "text", "id": "good_to_know_title", "label": "\"Good to know\" title", "default": "Good to know" },
    {
      "type": "richtext",
      "id": "good_to_know",
      "label": "\"Good to know\" text",
      "info": "State what it is NOT, from your real sample (e.g. how warm it is). Reduces returns."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Label" },
        { "type": "text", "id": "value", "label": "Value", "info": "Leave empty to hide this row." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OP · Specs & size",
      "blocks": [
        { "type": "row", "settings": { "label": "Material", "value": "" } },
        { "type": "row", "settings": { "label": "Weight / thickness", "value": "" } },
        { "type": "row", "settings": { "label": "Fit", "value": "One size, adult unisex" } },
        { "type": "row", "settings": { "label": "Head circumference", "value": "" } },
        { "type": "row", "settings": { "label": "Coverage", "value": "Full face with ear shapes" } },
        { "type": "row", "settings": { "label": "Openings", "value": "" } },
        { "type": "row", "settings": { "label": "Care", "value": "" } }
      ]
    }
  ]
}
{% endschema %}
