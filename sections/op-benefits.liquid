{% comment %}
  Benefits: icon + short headline + one line. Keep claims inside your product facts.
{% endcomment %}
{{ 'op.css' | asset_url | stylesheet_tag }}

<section class="op-section op-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="op-section__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="op-benefits__list list-unstyled">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <li class="op-benefits__item" {{ block.shopify_attributes }}>
            <span class="op-benefits__icon">{% render 'op-icon', icon: block.settings.icon, size: 28 %}</span>
            <div>
              <h3 class="op-benefits__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="op-benefits__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "OP · Benefits",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why people buy two" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "laugh", "options": [{ "value": "laugh", "label": "Laugh" },{ "value": "camera", "label": "Camera" },{ "value": "users", "label": "Group" },{ "value": "gift", "label": "Gift" },{ "value": "snow", "label": "Snow" },{ "value": "party", "label": "Party" },{ "value": "mask", "label": "Mask" },{ "value": "heart", "label": "Heart" },{ "value": "star", "label": "Star" },{ "value": "check", "label": "Check" },{ "value": "truck", "label": "Truck" },{ "value": "lock", "label": "Lock" },{ "value": "shield", "label": "Shield" },{ "value": "return", "label": "Return" },{ "value": "clock", "label": "Clock" }] },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "text", "id": "text", "label": "One line" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OP · Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "laugh", "title": "Built for double takes", "text": "Walk in, wait two seconds, watch the room react." } },
        { "type": "benefit", "settings": { "icon": "camera", "title": "Made for the camera", "text": "The kind of photo that ends up in the group chat for years." } },
        { "type": "benefit", "settings": { "icon": "users", "title": "Better as a pair", "text": "One is funny. Two walking in together is a moment." } },
        { "type": "benefit", "settings": { "icon": "gift", "title": "An easy gag gift", "text": "For the friend who already owns everything." } }
      ]
    }
  ]
}
{% endschema %}
