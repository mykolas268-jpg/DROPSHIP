{% comment %}
  Final CTA: repeats the bundle selector. Shares state with the top selector and the sticky bar.
{% endcomment %}
{%- liquid
  assign op_product = product
  if op_product == blank
    assign op_product = section.settings.product | default: settings.op_product
  endif
-%}
{{ 'op.css' | asset_url | stylesheet_tag }}
<script src="{{ 'op-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'op-bundle.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'op-delivery.js' | asset_url }}" defer="defer"></script>

{%- if op_product != blank -%}
  <section class="op-section op-final color-{{ section.settings.color_scheme }} gradient" id="op-final">
    <div class="page-width op-final__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="op-section__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="op-section__sub">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_image and op_product.featured_media -%}
        <div class="op-final__image">
          {{
            op_product.featured_media
            | image_url: width: 600
            | image_tag: widths: '200, 300, 400, 600', sizes: '200px', loading: 'lazy', alt: op_product.featured_media.alt
          }}
        </div>
      {%- endif -%}
      {% render 'op-buy-box', product: op_product, context: 'final', section_id: section.id %}
      {%- if section.settings.show_delivery -%}
        {% render 'op-delivery', hide_event: true %}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "OP · Final CTA",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Only used on the homepage." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring a friend into it" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pick your pack. Mix colors if you like." },
    { "type": "checkbox", "id": "show_image", "label": "Show product image", "default": true },
    { "type": "checkbox", "id": "show_delivery", "label": "Show delivery estimate", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "OP · Final CTA" }]
}
{% endschema %}
